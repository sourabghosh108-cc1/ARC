7.5s 150 def request_json(url: str, payload: dict | None = None, timeout: int = 30) -> dict:
7.5s 151 data = None if payload is None else json.dumps(payload).encode('utf-8')
7.5s 152 request = urllib.request.Request(url, data=data, headers={'Content-Type': 'application/json'})
7.5s 153 with urllib.request.urlopen(request, timeout=timeout) as response:
7.5s 154 return json.loads(response.read().decode('utf-8'))
