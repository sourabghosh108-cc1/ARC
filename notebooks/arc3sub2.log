7.5s 174 print('vLLM server ready:', models, flush=True)
7.5s 175 return
7.5s 176 except Exception:
7.5s 177 time.sleep(5)
7.5s 178 raise TimeoutError(f'Timed out waiting for vLLM server at {url}.\nLast server log lines:\n{tail_server_log()}')
